# SenseEarth backend configuration. Copy to `.env` at the repository root and
# set the values you need; uvicorn reads them from the process environment.

# --- Google OAuth (optional, required for "Continue with Google") ----------
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console → APIs & Services → Credentials. See docs/GOOGLE_OAUTH.md for the
# exact click path, authorised origins and redirect URIs.
SENSEEARTH_GOOGLE_CLIENT_ID=
SENSEEARTH_GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered on the OAuth client, byte for byte.
SENSEEARTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# Where the OAuth callback sends the browser back to (no trailing slash).
SENSEEARTH_FRONTEND_URL=http://127.0.0.1:5173

# --- Sessions and CORS ------------------------------------------------------
# Signs session tokens. If unset, a random key is generated once in
# storage/.session_secret. Set a long random value in production.
SENSEEARTH_SECRET_KEY=
SENSEEARTH_SESSION_TTL=604800
SENSEEARTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Model -----------------------------------------------------------------
SENSEEARTH_MODEL=pspnet
SENSEEARTH_BACKBONE=hrnet_w18
SENSEEARTH_DEVICE=auto
SENSEEARTH_WEIGHTS=models/weights/pspnet_hrnet_w18.pth
SENSEEARTH_CHANGE_THRESHOLD=0.5
